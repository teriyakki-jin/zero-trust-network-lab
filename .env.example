# Copy this file to .env only when you want to choose credentials manually.
# scripts/start.ps1 generates random local credentials when .env is absent.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ALICE_PASSWORD=CHANGE_ME_ALICE_PASSWORD
BOB_PASSWORD=CHANGE_ME_BOB_PASSWORD
KEYCLOAK_HOST_PORT=8080
PEP_HOST_PORT=8081

# JWT issuer and audience validated by the PEP.
OIDC_ISSUER=http://localhost:8080/realms/zero-trust
OIDC_AUDIENCE=zero-trust-api
